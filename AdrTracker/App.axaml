<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AdrTracker.App"
             xmlns:local="using:AdrTracker"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <FontFamily x:Key="Stratum2Regular">/Resources/Fonts/stratum2-regular-webfont.ttf#Stratum2</FontFamily>
    <FontFamily x:Key="Stratum2Bold">/Resources/Fonts/stratum2-bold-webfont.ttf#Stratum2</FontFamily>
  </Application.Resources>
  
    <Application.Styles>
      <FluentTheme />

      <Style Selector="Button">
        <Setter Property="Foreground" Value="WhiteSmoke"/>
      </Style>

      <Style Selector="Label">
        <Setter Property="Foreground" Value="WhiteSmoke"/>
      </Style>

      <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="WhiteSmoke"/>
      </Style>

      <Style Selector="Window">
        <Setter Property="WindowStartupLocation" Value="Manual"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Opacity" Value="0.8"/>
        <Setter Property="ShowInTaskbar" Value="False"/>
        <Setter Property="Width" Value="220"/>
        <Setter Property="SystemDecorations" Value="None"/>
        <Setter Property="FontFamily" Value="{StaticResource Stratum2Regular}"/>
      </Style>

      <Style Selector="Border#BorderWindow">
        <Setter Property="Background" Value="#222222"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="8"/>
      </Style>

      <Style Selector="TextBlock#Headline">
        <Setter Property="Foreground" Value="WhiteSmoke"/>
        <Setter Property="FontFamily" Value="{StaticResource Stratum2Bold}"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontStyle" Value="Italic"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="0,0,4,0"/>
      </Style>

      <!-- Textbox -->
      <Style Selector="TextBox">
        <Setter Property="BorderBrush" Value="Black"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="MinHeight" Value="8"/>
        <Setter Property="MinWidth" Value="8"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
      </Style>

      <Style Selector="TextBox:focus">
        <Setter Property="Foreground" Value="{DynamicResource TextControlForegroundFocused}" />

        <Style Selector="^ /template/ TextBlock#PART_Watermark">
          <Setter Property="Foreground" Value="{DynamicResource TextControlPlaceholderForegroundFocused}" />
        </Style>

        <Style Selector="^ /template/ Border#PART_BorderElement">
          <Setter Property="Background" Value="{DynamicResource TextControlBackgroundFocused}"/>
          <Setter Property="BorderBrush" Value="{DynamicResource TextControlBorderBrushFocused}"/>
          <Setter Property="BorderThickness" Value="1" />
        </Style>
      </Style>

      <Style Selector="TextBox:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource TextControlForegroundPointerOver}" />

        <Style Selector="^ /template/ Border#PART_BorderElement">
          <Setter Property="BorderBrush" Value="{DynamicResource TextControlBorderBrushPointerOver}"/>
          <Setter Property="Background" Value="{DynamicResource TextControlBackgroundPointerOver}" />
        </Style>

        <Style Selector="^ /template/ TextBlock#PART_Watermark">
          <Setter Property="Foreground" Value="{DynamicResource TextControlPlaceholderForegroundPointerOver}" />
        </Style>
      </Style>
      <!-- # ### #-->
      
      <!-- ComboBox -->
      <Style Selector="ComboBox">
        <Setter Property="Padding" Value="4,0,4,0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Height" Value="12"/>
        <Setter Property="MinHeight" Value="24"/>

        <Style Selector="^ /template/ PathIcon#DropDownGlyph">
          <Setter Property="Padding" Value="0"/>
          <Setter Property="Width" Value="4"/>
          <Setter Property="Height" Value="4"/>
          <Setter Property="Margin" Value="0"/>
        </Style>
      </Style>
      <!-- # ### #-->
      
      <!-- ListBox -->
      <Style Selector="ListBox">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>

        <Style Selector="^ /template/ Border">
          <Setter Property="Background" Value="Transparent"/>
        </Style>
      </Style>

      <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
      </Style>

      <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
      </Style>
      <!-- # ### #-->

      <!-- Expander-->
      <Style Selector="Expander">
        <Setter Property="Template">
          <ControlTemplate>
            <StackPanel>
              <ToggleButton
                Name="PART_Header"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="0"
                Padding="4,2"
                Content="{TemplateBinding Header}"
                IsChecked="{TemplateBinding IsExpanded}"
                Focusable="False">
                <ToggleButton.ContentTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <!-- Arrow icon -->
                      <Path
                        Width="12"
                        Height="12"
                        Stretch="Uniform"
                        Stroke="WhiteSmoke"
                        StrokeThickness="2"
                        Data="M 3 5 L 6 8 L 9 5">
                        <Path.RenderTransform>
                          <RotateTransform Angle="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" CenterX="6" CenterY="6"/>
                        </Path.RenderTransform>
                      </Path>
                      <ContentPresenter Content="{Binding}" />
                    </StackPanel>
                  </DataTemplate>
                </ToggleButton.ContentTemplate>
              </ToggleButton>
              <ContentPresenter
                Name="PART_Content"
                IsVisible="{TemplateBinding IsExpanded}"
                Content="{TemplateBinding Content}"/>
            </StackPanel>
          </ControlTemplate>
        </Setter>
      </Style>
      <Style Selector="Expander /template/ Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
      </Style>
      <Style Selector="Expander /template/ ToggleButton#PART_Header">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
      </Style>
      <!-- # ### #-->
    </Application.Styles>
</Application>